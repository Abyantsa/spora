# ==========================================
# SPORA - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Environment & Sensitive Files
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Jangan kembangkan kunci rahasia/private keys
*.pem
*.key
*.cert

# Kecualikan file contoh env agar tim tahu format env
!.env.example

# ------------------------------------------
# Dependencies
# ------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# Next.js Build Output & Cache
# ------------------------------------------
/.next/
/out/
/build
/dist

# ------------------------------------------
# Vercel & Supabase Local CLI
# ------------------------------------------
.vercel
.supabase/

# ------------------------------------------
# Debug & Log Files
# ------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
*.pem
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# TypeScript & Testing
# ------------------------------------------
/coverage
*.tsbuildinfo
next-env.d.ts

